__pycache__/
*.pyc
.venv/
*.egg-info/
build/
dist/

# runtime state: quarantined samples, job queue, logs, transcripts, host keys
var/logs/*
var/transcripts/*
var/quarantine/*
var/jobs/*
!var/logs/.gitkeep
!var/transcripts/.gitkeep
!var/quarantine/.gitkeep
!var/jobs/.gitkeep
var/ssh_host_key
# host keys mounted into the docker deployment: private keys, never commit
var/keys/
# per-deployment compose settings (ports); template: docker-compose.override.yml.example
docker-compose.override.yml

# same, for the separate var/training/ tree used by configs/training.yaml
var/training/logs/*
var/training/transcripts/*
var/training/quarantine/*
var/training/jobs/*
!var/training/logs/.gitkeep
!var/training/transcripts/.gitkeep
!var/training/quarantine/.gitkeep
!var/training/jobs/.gitkeep
var/training/ssh_host_key

# tools/dashboard.py output + the GeoLite2 DB it optionally reads (MaxMind's
# license requires fetching it yourself, not redistributing it in the repo)
var/dashboard.html
var/training/dashboard.html
*.mmdb
configs/geo_lite_key
# the extracted GeoLite2 download itself, wherever it's unpacked (tools/geo/
# is otherwise just our own small bundled world_outline.json map asset)
GeoLite2-City_*/
# real event logs pulled down from a live deployment for local dashboard
# generation -- contains real attacker IPs/credentials, never committed
var/live-droplet/
